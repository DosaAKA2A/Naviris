{
  "name": "naviris-browser",
  "productName": "Naviris",
  "version": "3.0.0-dev.1",
  "description": "Naviris",
  "author": "Iris Studio",
  "license": "MIT",
  "main": "src/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/DosaAKA2A/Naviris.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-timeout=20000 \"test/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/*.test.js\" \"test/e2e/arranque.e2e.js\" \"test/e2e/perfiles.e2e.js\" \"test/e2e/huecos.e2e.js\"",
    "icon": "electron build/render-icon.js",
    "icon-ico": "electron build/make-ico.js",
    "fetch-bin": "node build/fetch-bin.js",
    "adblock-recursos": "node build/adblock-recursos.js",
    "test:e2e:adblock": "node --test --test-concurrency=1 test/e2e/adblock.e2e.js",
    "dist": "electron-builder --win",
    "release": "npm run dist && node build/publish-release.js",
    "publish": "node build/publish-release.js",
    "dist-publish": "npm run dist && node build/publish-release.js"
  },
  "devDependencies": {
    "electron": "github:castlabs/electron-releases#v42.5.2+wvcus",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.estudiodeiris.cobalt",
    "productName": "Naviris",
    "afterSign": "build/evs-sign.js",
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/",
      "customDir": "v{{ version }}"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "resources/adblock/**/*",
      "build/icon.png",
      "build/icon.ico",
      "!node_modules/adblock-rs/{target,src,benches,fuzz}/**",
      "!node_modules/adblock-rs/{Cargo.lock,Cargo.toml,rust-toolchain.toml,rustfmt.toml,CHANGELOG.md,README.md,SECURITY.md}"
    ],
    "electronLanguages": [
      "es",
      "es-419",
      "en-US"
    ],
    "icon": "build/icon.ico",
    "publish": {
      "provider": "github",
      "owner": "DosaAKA2A",
      "repo": "Naviris",
      "releaseType": "prerelease",
      "channel": "dev"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "shortcutName": "Naviris",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "afterPack": "build/afterPack.js"
  },
  "dependencies": {
    "adblock-rs": "^0.13.2",
    "electron-updater": "^6.8.9"
  }
}
